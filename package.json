{
  "name": "bpmn-sketch-miner",
  "displayName": "BPMN Sketch Miner",
  "publisher": "s-v-o",
  "description": "Show Editor content in BPMN Sketch Miner",
  "icon": "images/vscode-bpmn-sketch-miner.png",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.55.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Visualization",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/s-v-o/vscode-bpmn-sketch-miner.git"
  },
  "activationEvents": [
    "onCommand:bpmn-sketch-miner.show"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "BPMN-Sketch-Miner",
      "properties": {
        "bpmn-sketch-miner.autoRefresh": {
          "type": "boolean",
          "default": "false",
          "description": "Refresh the web view automatically after changes."
        },
        "bpmn-sketch-miner.autoRefreshTimeout": {
          "type": "integer",
          "default": 1000,
          "description": "Time in ms before AutoRefresh is triggered (for debouncing)."
        },
        "bpmn-sketch-miner.generatorSource": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "hybrid",
            "web"
          ],
          "description": "Source of the used generator."
        }
      }
    },
    "commands": [
      {
        "command": "bpmn-sketch-miner.show",
        "title": "Show BPMN"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "package": "pnpm vsce package",
    "publish": "pnpm vsce publish",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/lz-string": "^1.3.34",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vscode/vsce": "^2.26.1",
    "esbuild": "^0.21.4",
    "eslint": "^10.4.1",
    "node": "^24.16.0",
    "typescript": "^6.0.3",
    "vscode-test": "^1.5.0"
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  }
}